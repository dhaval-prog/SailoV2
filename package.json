{
  "name": "sailo",
  "productName": "Sailo",
  "version": "1.0.0",
  "description": "Sail. Discover. Connect. — Lighthouse Tug sailing experience for desktop and mobile.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Sailo",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "desktop:dev": "electron . --dev",
    "desktop:dist": "vite build && electron-builder",
    "mobile:sync": "vite build && cap sync",
    "android": "vite build && cap sync android && cap open android",
    "ios": "vite build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@mapbox/vector-tile": "^2.0.5",
    "pbf": "^4.0.2",
    "three": "0.184.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.sailo.app",
    "productName": "Sailo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  }
}
